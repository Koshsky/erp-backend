# App reads only these secrets + URL; non-secret settings live in config.yaml.
# DATABASE_NAME/USER/PASSWORD are used by docker-compose for the postgres and
# flyway containers only (not by the app).
DATABASE_URL=postgres://erp:changeme@db:5432/erp?sslmode=disable

# Database (compose infra: postgres + flyway)
DATABASE_NAME=erp
DATABASE_USER=erp
DATABASE_PASSWORD=changeme

# JWT Service
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_REFRESH_KEY=super-refresh-key-change-in-production

# Grafana (audit-log UI) — compose infra only (the app does not read it).
GF_ADMIN_PASSWORD=change-me
