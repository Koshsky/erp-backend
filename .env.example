# Database
DATABASE_NAME=erp
DATABASE_USER=erp
DATABASE_PASSWORD=changeme
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_SSL_MODE=disable

# JWT Service
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_REFRESH_KEY=super-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
JWT_ISSUER=mvs-erp

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Swagger
SWAGGER_ENABLE=true
